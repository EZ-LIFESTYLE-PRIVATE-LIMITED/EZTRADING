# Local development. Copy to .env and adjust.

ENV=development
PUBLIC_BASE_URL=http://127.0.0.1:8000
DATABASE_URL=sqlite:///data/eztrading.db
# Sign up in the app with any email; outside production the email code is always this:
# FIXED_OTP=7891



# "kite" uses each user's Kite keys (set in the app's Settings); "fake" = sample holdings
BROKER=kite
# "nse" (live, unofficial) or "fake" (sample IPOs)
IPO_SOURCE=nse

# Server-wide AI keys used when a user hasn't added their own
DEFAULT_ADVISOR=gemini:gemini-3.6-flash
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Premium: server AI keys are premium-only, here too. Buy it in the app: the stub's test payment
# succeeds outside production (no money moves). Set false to turn the paywall off locally.
# PREMIUM_ENFORCED=true
# PREMIUM_PRICE_INR=199
# PAYMENT_PROVIDER=stub

# Email + password sign-in. Optional SMTP; without it, emails are only logged (development only).
# PASSWORD_LOGIN=true
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=EZTrading <no-reply@example.com>

# Set to false to hide Execute and reject all order requests
# ORDERS_ENABLED=true



WATCHLIST=RELIANCE,HDFCBANK,ICICIBANK,INFY,TCS,BHARTIARTL,ITC,LT,SBIN,AXISBANK,KOTAKBANK,HINDUNILVR,BAJFINANCE,MARUTI,SUNPHARMA,TITAN,ULTRACEMCO,NTPC

# Telegram (optional). Use a separate bot for local: the server polls it, no public URL needed.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=
# TELEGRAM_WEBHOOK_SECRET=

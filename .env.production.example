# Production settings for docker compose. Copy to .env on the server and fill in.
# Generate secrets with: docker compose run --rm --no-deps web python scripts/gen_keys.py
#   (or locally: python scripts/gen_keys.py)

DOMAIN=trade.example.com
PUBLIC_BASE_URL=https://trade.example.com
POSTGRES_PASSWORD=change-me-long-random

SESSION_SECRET=
APP_ENCRYPTION_KEY=
# Optional: only these emails may sign in (comma-separated). Empty = anyone with a Google account.
ALLOWED_EMAILS=

# Google OAuth client (Web application). Authorized redirect URI: https://<DOMAIN>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Server-wide AI keys (users can override with their own in Settings). Leave empty to require user keys.
DEFAULT_ADVISOR=gemini:gemini-3.6-flash
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Premium (enforced in production). Price in rupees; coupon FREE7 gives 7 free days (WELCOME_COUPON= to disable).
PREMIUM_PRICE_INR=199
PREMIUM_PERIOD_DAYS=30
WELCOME_COUPON=FREE7
WELCOME_COUPON_DAYS=7
# Payment provider. "stub" can't take real payments in production; coupons still work.
PAYMENT_PROVIDER=stub

# Email + password sign-in with email codes. Leave SMTP_HOST empty to offer Google sign-in only.
PASSWORD_LOGIN=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# false = hide Execute and reject all orders (analysis only)
ORDERS_ENABLED=true

# Web Push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Telegram bot (from @BotFather). Then register the webhook (see README).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Market data
BROKER=kite
IPO_SOURCE=nse
# NSE trading holidays (YYYY-MM-DD, comma-separated) so auto-analysis skips them
NSE_HOLIDAYS=
WEB_WORKERS=2
